# Names only. Real values live only in Portainer's stack environment, never in git or chat.
DATA_ROOT=/srv/appdata/marketplace-monitor   # host folder for all state (mode 700)
SRC_ROOT=/opt/ai-marketplace-monitor/control-panel   # this folder on the Docker host
LAN_IP=192.168.1.10   # the host's LAN address; the panel is published there only
TZ=Asia/Jerusalem
TG_BOT_TOKEN=       # secret, from @BotFather
TG_CHAT_ID=         # target chat/group id
NOTIFY_ENABLED=false   # initial value only; afterwards set in the panel
GEMINI_API_KEY=     # secret, free-tier key from a project WITHOUT billing
GUARD_TOKEN=        # secret, random >=16 chars; the panel writes it into the generated config.toml ([ai.guard] api_key)
AGENT_TOKEN=        # secret, random >=16 chars; panel <-> scraper control agent
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=8
GEMINI_RPD=400
UI_USER=
UI_PASS=            # secret, >= 12 chars
RECAP_HOUR=21   # initial value only; afterwards set in the panel
RETENTION_DAYS=60
SCRAPER_REPLICAS=1   # container idle; the scraper PROCESS stays off until started in the panel (0 removes the container)
# AIMM_IMAGE=   # optional override of the pinned scraper image digest
